{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "rounds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "categories": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "clues": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "clue": {
                        "type": "string",
                        "minLength": 1
                      },
                      "answer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dailyDouble": {
                        "type": "boolean"
                      },
                      "media": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "image",
                              "audio",
                              "video"
                            ]
                          },
                          "src": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "type",
                          "src"
                        ]
                      },
                      "notes": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "value",
                      "clue",
                      "answer"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "clues"
              ]
            }
          },
          "randomDailyDoubles": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "categories"
        ]
      }
    },
    "final": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "clue": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "image",
                "audio",
                "video"
              ]
            },
            "src": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "type",
            "src"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "category",
        "clue",
        "answer"
      ]
    }
  },
  "required": [
    "id",
    "title",
    "rounds"
  ]
}
