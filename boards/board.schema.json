{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "rounds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "categories": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "clues": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "buzz",
                          "allPlay",
                          "closest"
                        ]
                      },
                      "number": {
                        "type": "number"
                      },
                      "seconds": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 120
                      },
                      "value": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "clue": {
                        "type": "string",
                        "minLength": 1
                      },
                      "answer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dailyDouble": {
                        "type": "boolean"
                      },
                      "media": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "image",
                              "audio",
                              "video"
                            ]
                          },
                          "src": {
                            "type": "string",
                            "format": "uri"
                          },
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "reveal": {
                            "type": "object",
                            "properties": {
                              "style": {
                                "type": "string",
                                "const": "blur"
                              },
                              "seconds": {
                                "type": "number",
                                "minimum": 3,
                                "maximum": 120
                              },
                              "shrinkPoints": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "style"
                            ]
                          }
                        },
                        "required": [
                          "type",
                          "src"
                        ]
                      },
                      "answerMedia": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "image",
                              "audio",
                              "video"
                            ]
                          },
                          "src": {
                            "type": "string",
                            "format": "uri"
                          },
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "reveal": {
                            "type": "object",
                            "properties": {
                              "style": {
                                "type": "string",
                                "const": "blur"
                              },
                              "seconds": {
                                "type": "number",
                                "minimum": 3,
                                "maximum": 120
                              },
                              "shrinkPoints": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "style"
                            ]
                          }
                        },
                        "required": [
                          "type",
                          "src"
                        ]
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sourceUrl": {
                        "type": "string",
                        "format": "uri"
                      },
                      "acceptedAnswers": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "notes": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "value",
                      "clue",
                      "answer"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "clues"
              ]
            }
          },
          "randomDailyDoubles": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "categories"
        ]
      }
    },
    "final": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "clue": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "image",
                "audio",
                "video"
              ]
            },
            "src": {
              "type": "string",
              "format": "uri"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reveal": {
              "type": "object",
              "properties": {
                "style": {
                  "type": "string",
                  "const": "blur"
                },
                "seconds": {
                  "type": "number",
                  "minimum": 3,
                  "maximum": 120
                },
                "shrinkPoints": {
                  "type": "boolean"
                }
              },
              "required": [
                "style"
              ]
            }
          },
          "required": [
            "type",
            "src"
          ]
        },
        "answerMedia": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "image",
                "audio",
                "video"
              ]
            },
            "src": {
              "type": "string",
              "format": "uri"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reveal": {
              "type": "object",
              "properties": {
                "style": {
                  "type": "string",
                  "const": "blur"
                },
                "seconds": {
                  "type": "number",
                  "minimum": 3,
                  "maximum": 120
                },
                "shrinkPoints": {
                  "type": "boolean"
                }
              },
              "required": [
                "style"
              ]
            }
          },
          "required": [
            "type",
            "src"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "acceptedAnswers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "category",
        "clue",
        "answer"
      ]
    },
    "tiebreaker": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "clue": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "image",
                "audio",
                "video"
              ]
            },
            "src": {
              "type": "string",
              "format": "uri"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reveal": {
              "type": "object",
              "properties": {
                "style": {
                  "type": "string",
                  "const": "blur"
                },
                "seconds": {
                  "type": "number",
                  "minimum": 3,
                  "maximum": 120
                },
                "shrinkPoints": {
                  "type": "boolean"
                }
              },
              "required": [
                "style"
              ]
            }
          },
          "required": [
            "type",
            "src"
          ]
        },
        "answerMedia": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "image",
                "audio",
                "video"
              ]
            },
            "src": {
              "type": "string",
              "format": "uri"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reveal": {
              "type": "object",
              "properties": {
                "style": {
                  "type": "string",
                  "const": "blur"
                },
                "seconds": {
                  "type": "number",
                  "minimum": 3,
                  "maximum": 120
                },
                "shrinkPoints": {
                  "type": "boolean"
                }
              },
              "required": [
                "style"
              ]
            }
          },
          "required": [
            "type",
            "src"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "acceptedAnswers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "category",
